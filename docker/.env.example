# Supabase PostgreSQL Session pooler connection
SUPABASE_DB_HOST=aws-<region>-<index>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=replace-with-your-database-password
SUPABASE_DB_SSLMODE=require

# Generate a unique Laravel key with: php artisan key:generate --show
APP_KEY=base64:replace-with-a-unique-generated-key

# Private credentials used by local services
REDIS_PASSWORD=replace-with-a-strong-password
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
